# ==============================================================================
# Saarthi Production & Local Development Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, pgvector)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-admin-key

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Object Storage (Documents, Notices, Invoices, Proofs)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=saarthi-documents
R2_PUBLIC_DOMAIN=https://pub-your_bucket_id.r2.dev

# ------------------------------------------------------------------------------
# 3. Redis BullMQ Queue State Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Microservice Orchestration & Internal Tokens
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
FASTAPI_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-in-prod

# ------------------------------------------------------------------------------
# 5. AI & Regulatory Models (Optional External Providers)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-optional-external-openai-key
HUGGINGFACE_API_KEY=hf_optional_external_token

# ------------------------------------------------------------------------------
# 6. Razorpay Sandbox / Live Payment Gateway
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_sandbox_mock_id
RAZORPAY_KEY_SECRET=rzp_test_sandbox_mock_secret

# ------------------------------------------------------------------------------
# 7. WhatsApp Business API / Copilot Webhook
# ------------------------------------------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=saarthi_whatsapp_verify_token_2026
WHATSAPP_ACCESS_TOKEN=eaab_optional_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=10009876543210
